# Copy this file to `.env` and fill in your key:
#   cp .env.example .env
#
# Every script in this package reads its API key from here:
#   - Python entry points load it automatically (python-dotenv).
#   - Shell scripts `source` it.
# An already-exported OPENAI_API_KEY in your shell takes precedence.

# OpenAI API key (required for Batch API clustering / approach generation).
export OPENAI_API_KEY=""

# Optional: OpenAI-compatible base URL (e.g. a local vLLM server).
# When set and OPENAI_API_KEY is empty, "EMPTY" is used as the key.
# export OPENAI_BASE_URL="http://localhost:8000/v1"
